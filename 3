''' <summary>
''' Reconciliation of Departments with Aurion via Schedule
''' </summary>
''' <returns>String result message</returns>
''' 
Public Function CCC_Department_Import(Optional ByVal importSource As String = "AUR") As String
	Dim configBase As String = CCC_Aurion_GetConfigBase(importSource)
	Dim loggerName As String = CCC_Aurion_GetLoggerPrefix(importSource) & "_DEPTS"
	CCC_NLog_WriteLog(loggerName, "Debug", "Entering CCC_Department_Import()")
	'
	' This script will sync the Org Unit records from Aurion HR to the Department table in OneIM
	'
	' vars
	Dim strRtnValue As String = String.Empty
	Dim intNewObjs As Integer = 0
	Dim intUpdatedObjs As Integer = 0
	Dim intDeletedObjs As Integer = 0
	Dim strXMLDoc As String = String.Empty
	Dim xmlDoc As Xml.XmlDocument = New Xml.XmlDocument
	' Initiate Web Service
	Dim QUERY_ID As String = Connection.GetConfigParm(configBase & "\QueryFilterFields\QueryIDs\Departments").ToString()
	Dim P_TOKEN As String = CCC_Aurion_LOGON(importSource)
	' Perform Supervisor Single-Query to XML Document
	strXMLDoc = CCC_Aurion_QUERY_TO_XML(loggerName, P_TOKEN, QUERY_ID, String.Empty, importSource)
	Try
		xmlDoc.LoadXml(strXMLDoc)
	Catch ex As Exception
		Dim strErrorMsg As StringBuilder = New StringBuilder
		strErrorMsg.AppendLine("Error loading XML.")
		strErrorMsg.AppendLine(ex.Message())
		' Disconnect Web Service
		CCC_NLog_WriteLog(loggerName, "Debug", "Calling CCC_Aurion_LOGOFF(P_TOKEN, importSource)")
		CCC_Aurion_LOGOFF(P_TOKEN, importSource)
		' Throw error
		CCC_NLog_WriteLog(loggerName, "Fatal", strErrorMsg.ToString())
		Throw New AdHocDataException("Error loading XML. " & strErrorMsg.ToString())
	End Try
	' Disconnect Web Service
	CCC_NLog_WriteLog(loggerName, "Debug", "Calling CCC_Aurion_LOGOFF(P_TOKEN, importSource)")
	CCC_Aurion_LOGOFF(P_TOKEN, importSource)
	' Main processing
	RaiseMessage(MsgSeverity.Info, "AURION - CCC_Department_Import - Starting snychronisation")
	' SYNC WITH ONEIM OBJECTS
	' load departments from DB
	Dim dbDepts As IColDbObject = Connection.CreateCol("Department")
	dbDepts.Prototype.PutValue("ImportSource", importSource)
	dbDepts.Prototype("DepartmentName").IsDisplayItem = True
	dbDepts.Prototype("ObjectID").IsDisplayItem = True
	dbDepts.Prototype("Description").IsDisplayItem = True
	dbDepts.Prototype("IsInActive").IsDisplayItem = True
	dbDepts.Prototype("UID_ParentDepartment").IsDisplayItem = True
	CCC_NLog_WriteLog(loggerName, "Debug", "Load Department")
	dbDepts.Load()
	Dim dbDeptIDs As ArrayList = New ArrayList
	Dim xmlDeptIDs As ArrayList = New ArrayList
	For Each dbDept In dbDepts
		dbDeptIDs.Add(dbDept.GetValue("ObjectID").ToString())
	Next
	' compare with org units in xml doc
	CCC_NLog_WriteLog(loggerName, "Debug", "Loop through XML")
	For Each node As System.Xml.XmlElement In xmlDoc.DocumentElement
		Dim strName As String = node.Item("Organisation_Unit_Name").InnerText
		Dim strNumber As String = node.Item("Organisation_Unit_Number").InnerText
		Dim strStatus As String = node.Item("Organisation_Unit_Status").InnerText
		Dim strLevel As String = node.Item("Organisation_Unit_Level").InnerText
		Dim strParentNumber As String = node.Item("Superior_Org_Unit_Number").InnerText
		Dim strDescription As String = node.Item("Organisation_Unit_Description").InnerText
		
		' 13/06/2023 - BP Add Prefixes to Departments
		Dim deptPrefix As String = Connection.GetConfigParm(configBase & "\PersonnelNumberPrefix").ToString()
		strNumber = deptPrefix & strNumber
		strParentNumber = deptPrefix & strParentNumber
		
		xmlDeptIDs.Add(strNumber)
		If dbDeptIDs.Contains(strNumber) Then
			Try
				' dept exists in OneIM. Update attributes if needed
				dbDepts.Clear()
				dbDepts.Prototype.WhereClause = "ObjectID = '" & strNumber & "' AND ImportSource = '" & importSource & "'"
				CCC_NLog_WriteLog(loggerName, "Trace", "Load Department.ObjectGUID = '" & strNumber & "' AND ImportSource = '" & importSource & "'")
				dbDepts.Load()
				Dim singleObj As ISingleDbObject = dbDepts(0).Create()
				For Each nodeItem As System.Xml.XmlElement In node
					' compare attribute values between XML doc and DB object
					Select Case LCase(nodeItem.Name)
						Case "organisation_unit_status"
							' check DB record for status
							If (strStatus.ToUpperInvariant() = "ACTIVE") AndAlso (singleObj.GetValue("IsInActive").ToString.ToUpperInvariant() = "TRUE") Then
								' XML shows active, department is inactive in DB. Set to active
								CCC_NLog_WriteLog(loggerName, "Debug", "Activating deactive department")
								singleObj.PutValue("IsInActive", "False")
								singleObj.PutValue("CustomProperty10", "")
							End If
						Case "organisation_unit_name"
							If (strName <> singleObj.GetValue("DepartmentName").ToString) Then
								CCC_NLog_WriteLog(loggerName, "Debug", "Updating DepartmentName")
								singleObj.PutValue("DepartmentName", strName)
							End If
						Case "organisation_unit_description"
							If (strDescription <> singleObj.GetValue("Description").ToString) Then
								CCC_NLog_WriteLog(loggerName, "Debug", "Updating Description")
								singleObj.PutValue("Description", strDescription)
							End If
						Case "superior_org_unit_number"
							Dim parentDeptID As String = Connection.GetSingleProperty("Department", "ObjectID", "UID_Department = '" & singleObj.GetValue("UID_ParentDepartment").ToString() & "' AND ImportSource = '" & importSource & "'").ToString()
							If (strParentNumber.ToUpperInvariant() <> parentDeptID.ToUpperInvariant()) Then
								' parent department has changed. Load new GUID, set to current dept object
								Dim newparentDeptGUID As String = Connection.GetSingleProperty("Department", "UID_Department", "ObjectID = '" & strParentNumber & "' AND ImportSource = '" & importSource & "'")
								If newparentDeptGUID.Length() > 1 Then
									CCC_NLog_WriteLog(loggerName, "Debug", "Updating parent department")
									singleObj.PutValue("UID_ParentDepartment", newparentDeptGUID)
								End If
							End If
					End Select
				Next
				If singleObj.IsChanged() = True Then
					' department's attribute values have changed. Save the record to the DB
					singleObj.Save()
					intUpdatedObjs = intUpdatedObjs + 1
				End If
			Catch ex As Exception
				Dim strErrorMsg As StringBuilder = New StringBuilder
				strErrorMsg.AppendLine("Error updating department attributes.")
				strErrorMsg.AppendLine("Department ID: " & strNumber)
				strErrorMsg.AppendLine(ex.Message())
				CCC_NLog_WriteLog(loggerName, "Error", strErrorMsg.ToString())
				RaiseMessage(MsgSeverity.Serious, "AURION - CCC_Department_Import " & vbCrLf & strErrorMsg.ToString())
			End Try
		Else
			Try
				' dept not in OneIM. Create it
				Dim newDbObject As ISingleDbObject = Connection.CreateSingle("Department")
				newDbObject.PutValue("ImportSource", importSource)
				'newDbObject.PutValue("CustomProperty01", "AUR") - debugging purposes
				newDbObject.PutValue("DepartmentName", strName)
				newDbObject.PutValue("ObjectID", strNumber)
				newDbObject.PutValue("Description", strDescription)
				If Not (strStatus.ToUpperInvariant() = "ACTIVE") Then
					newDbObject.PutValue("IsInActive", "True")
				End If
				If strParentNumber.Length() > 0 Then
					Dim parentGUID As String = Connection.GetSingleProperty("Department", "UID_Department", "ObjectID = '" & strParentNumber & "' AND ImportSource = '" & importSource & "'")
					If parentGUID.Length() > 1 Then
						newDbObject.PutValue("UID_ParentDepartment", parentGUID)
					End If
				End If
				CCC_NLog_WriteLog(loggerName, "Debug", "Creating department")
				newDbObject.Save()
				intNewObjs = intNewObjs + 1
			Catch ex As Exception
				Dim strErrorMsg As StringBuilder = New StringBuilder
				strErrorMsg.AppendLine("Error inserting a new department.")
				strErrorMsg.AppendLine("Department ID: " & strNumber)
				strErrorMsg.AppendLine(ex.Message())
				CCC_NLog_WriteLog(loggerName, "Error", strErrorMsg.ToString())
				RaiseMessage(MsgSeverity.Serious, "AURION - CCC_Department_Import " & vbCrLf & strErrorMsg.ToString())
			End Try
		End If
	Next
	' handle those which only exist in OneIM
	Dim dbOnlyIDs As ArrayList = New ArrayList
	For Each dbID In dbDeptIDs
		If Not (xmlDeptIDs.Contains(dbID)) Then
			dbOnlyIDs.Add(dbID)
		End If
	Next
	If dbOnlyIDs.Count() > 0 Then
		' items in DB which do not exist in Aurion XML feed
		CCC_NLog_WriteLog(loggerName, "Debug", "Loop through missing Aurion Departments")
		For Each dbObjID As String In dbOnlyIDs
			Try
				dbDepts.Clear()
				dbDepts.Prototype.WhereClause = "ObjectID = '" & dbObjID & "' AND ImportSource = '" & importSource & "'"
				dbDepts.Load()
				Dim singleObj As ISingleDbObject = dbDepts(0).Create()
				If singleObj.GetValue("IsInActive").ToString.ToUpperInvariant() = "FALSE" Then
					singleObj.PutValue("IsInActive", "True")
					singleObj.PutValue("CustomProperty10", "DOES_NOT_EXIST")
					singleObj.Save()
					intDeletedObjs = intDeletedObjs + 1
				End If
			Catch ex As Exception
				Dim strErrorMsg As StringBuilder = New StringBuilder
				strErrorMsg.AppendLine("Error deactivating a department.")
				strErrorMsg.AppendLine("Department ID: " & dbObjID)
				strErrorMsg.AppendLine(ex.Message())
				CCC_NLog_WriteLog(loggerName, "Error", strErrorMsg.ToString())
				RaiseMessage(MsgSeverity.Serious, "AURION - CCC_Department_Import " & vbCrLf & strErrorMsg.ToString())
			End Try
		Next
	End If
	' return some stats
	Dim strWrite As StringBuilder = New StringBuilder
	strWrite.AppendLine("AURION HR - Department Import Script")
	strWrite.AppendLine("Total departments created: " & intNewObjs)
	strWrite.AppendLine("Total departments updated: " & intUpdatedObjs)
	strWrite.AppendLine("Total departments deactivated: " & intDeletedObjs)
	strRtnValue = strWrite.ToString()
	RaiseMessage(MsgSeverity.Info, "AURION - CCC_Department_Import " & vbCrLf & strWrite.ToString())
	CCC_NLog_WriteLog(loggerName, "Debug", "Exiting CCC_Department_Import()")
	Return strRtnValue
End Function


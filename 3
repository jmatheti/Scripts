		strXMLDoc = CCC_Aurion_QUERY_TO_XML(loggerName, P_TOKEN, QUERY_ID, filter, importSource)
	Else
		strXMLDoc = CCC_Aurion_QUERY_TO_XML(loggerName, P_TOKEN, QUERY_ID, String.Empty, importSource)
	End If
	
	Try
		xmlDoc.LoadXml(strXMLDoc)
	Catch ex As Exception
		Dim strErrorMsg As StringBuilder = New StringBuilder
		strErrorMsg.AppendLine("Error loading XML.")
		strErrorMsg.AppendLine(ex.Message())
		' Disconnect Web Service
		CCC_NLog_WriteLog(loggerName, "Debug", "Calling CCC_Aurion_LOGOFF(P_TOKEN, importSource)")
		CCC_Aurion_LOGOFF(P_TOKEN, importSource)
		' Throw error
		CCC_NLog_WriteLog(loggerName, "Fatal", strErrorMsg.ToString())
		Throw New AdHocDataException("Error loading XML. " & strErrorMsg.ToString())
	End Try
	' Disconnect Web Service
	CCC_NLog_WriteLog(loggerName, "Debug", "Calling CCC_Aurion_LOGOFF(P_TOKEN, importSource)")
	CCC_Aurion_LOGOFF(P_TOKEN, importSource)
	' Main processing
	RaiseMessage(MsgSeverity.Info, "AURION - CCC_Position_Import - Starting snychronisation")
	' SYNC WITH ONEIM OBJECTS
	' load positions from DB

	'Dim dbOrgs As IColDbObject = Connection.CreateCol("Org")
	'dbOrgs.Prototype.PutValue("ImportSource", importSource)
	'dbOrgs.Prototype.PutValue("UID_OrgRoot", strUIDOrgRoot)
	'dbOrgs.Prototype("Ident_Org").IsDisplayItem = True
	'dbOrgs.Prototype("InternalName").IsDisplayItem = True
	'dbOrgs.Prototype("UID_ParentOrg").IsDisplayItem = True
	'dbOrgs.Prototype("UID_Department").IsDisplayItem = True
	'dbOrgs.Prototype("UID_Locality").IsDisplayItem = True
	'dbOrgs.Prototype("CustomProperty01").IsDisplayItem = True
	'dbOrgs.Prototype("CustomProperty02").IsDisplayItem = True
	'dbOrgs.Prototype("CustomProperty03").IsDisplayItem = True
	'dbOrgs.Prototype("CustomProperty04").IsDisplayItem = True
	'dbOrgs.Prototype("CustomProperty09").IsDisplayItem = True
	'dbOrgs.Prototype("CustomProperty10").IsDisplayItem = True
	CCC_NLog_WriteLog(loggerName, "Debug", "Load Org")
	'dbOrgs.Load()
	
	Dim f As ISqlFormatter = Session.SqlFormatter
		' Pull Locality info
	Dim qLocalitys = Query.From("Locality").Where(f.Comparison("ImportSource", importSource, ValType.String, CompareOperator.Equal)).Select("UID_Locality", "Ident_Locality")
	Dim dbLocalitys As IEntityCollection = Session.Source.GetCollection(qLocalitys, EntityCollectionLoadType.Slim)

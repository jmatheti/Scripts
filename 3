	Dim qDepartments = Query.From("Department").Where(f.Comparison("ImportSource", importSource, ValType.String, CompareOperator.Equal)).Select("UID_Department", "ObjectID", "FullPath")
	Dim dbDepartments As IEntityCollection = Session.Source.GetCollection(qDepartments, EntityCollectionLoadType.Slim)

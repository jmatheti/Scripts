	Dim qOrg = Query.From("Org") _
		.Where(f.AndRelation(f.Comparison("UID_OrgRoot", strUIDOrgRoot, ValType.String, CompareOperator.Equal), f.Comparison("ImportSource", importSource, ValType.String, CompareOperator.Equal))) _
		.Select("ImportSource", "UID_OrgRoot", "Ident_Org", "InternalName", _
			"UID_ParentOrg", "UID_Department", "UID_Locality", "CustomProperty01", _
			"CustomProperty02", "CustomProperty03", "CustomProperty04", "CustomProperty09", _
			"CustomProperty10", "Remarks")
	Dim dbOrgs As IEntityCollection = Session.Source.GetCollection(qOrg, EntityCollectionLoadType.Bulk)
	Dim dbOrgIDs As HashSet(Of String) = New HashSet(Of String)
	Dim xmlOrgIDs As HashSet(Of String) = New HashSet(Of String)

	For Each dbOrg As IEntity In dbOrgs
		Dim identOrg As String = dbOrg.GetValue("Ident_Org").ToString()
		dbOrgIDs.Add(identOrg)
		dbOrgDict(identOrg) = dbOrg
	Next
	CCC_NLog_WriteLog(loggerName, "Debug", "Current Position Count in DB: " & dbOrgIDs.Count)
	
	' compare with org units in xml doc
	CCC_NLog_WriteLog(loggerName, "Debug", "Loop through XML")
	Dim retryCount As Integer = 0
	For Each node As System.Xml.XmlElement In xmlDoc.DocumentElement
		Dim strTitle As String = node.Item("Position_Full_Title").InnerText
		Dim strNumber As String = node.Item("Position_Number").InnerText
		Dim strStatus As String = node.Item("Position_Status").InnerText
		Dim strLocation As String = node.Item("Location_Code").InnerText
		Dim strParentNumber As String = node.Item("Reports_to_Position").InnerText
		Dim strClassification As String = node.Item("Classification").InnerText
		Dim strOrgUnit As String = node.Item("Organisation_Unit_Number").InnerText 
		

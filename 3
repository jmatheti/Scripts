		strNumber = personNumberPrefix & strNumber
		strParentNumber = personNumberPrefix & strParentNumber
		strLocation = personNumberPrefix & strLocation
		strOrgUnit = personNumberPrefix & strOrgUnit
		
		'detect multiple positions
		Dim strPreviousNumber As String = If(xmlElPrevious IsNot Nothing, xmlElPrevious.Item("Position_Number").InnerText, "")
		If (strNumber.Equals(strPreviousNumber, StringComparison.CurrentCultureIgnoreCase) OrElse xmlElPrevious Is Nothing) Then 'Split cost centres, do not update position at this time
			listXmlElMultiple.Add(node)
		Else
			'we have moved to the next position number so the list has finished building. Calculate cost center to use and apply to position object
			Dim xmlChosenCostCentre As XmlElement
			If (listXmlElMultiple.Count > 1) Then
				xmlChosenCostCentre = listXmlElMultiple _
					.OrderByDescending(Function(el) Decimal.Parse(el.Item("Percentage_Value").InnerText)) _
					.First()
			Else If (listXmlElMultiple.Count = 1) Then
				xmlChosenCostCentre = listXmlElMultiple.First()
			Else ' This should not happen, something has gone wrong
				Dim strErrorMsg As String = $"List for previous multiple positions is empty, current position is {strNumber}"
				CCC_NLog_WriteLog(loggerName, "Debug", strErrorMsg)
				RaiseMessage(MsgSeverity.Serious, $"AURION - CCC_Position_Import: " & strErrorMsg)
				Throw New AdHocDataException("Error parsing previous position data. " & strErrorMsg)
			End If
			'dbOrgs.Clear()
			'dbOrgs.Prototype.WhereClause = $"Ident_Org = '{strPreviousNumber}' AND ImportSource = '{importSource}'"
			CCC_NLog_WriteLog(loggerName, "Debug", $"Load previous object: Org.Ident_Org = '{strPreviousNumber}'")
			
			'dbOrgs.Load()
			'Dim previousPosition As ISingleDbObject = dbOrgs.First().Create()
			retryCount = 0
			RetryCosting:
			Try
				Dim previousPosition As IEntity = If(retryCount = 0, dbOrgDict(strPreviousNumber), Session.Source.Get("Org", dbOrgDict(strPreviousNumber).GetValue("UID_Org").ToString()))
				' Ensure that if this entity was modified/saved previously that we reload it here
				If previousPosition.IsReadOnly Then
					previousPosition = Session.Source.Get("Org", previousPosition.GetValue("UID_Org").ToString())
				End If
				Dim strCustomProperty01 As String = xmlChosenCostCentre.Item("Costing_Code_1").InnerText
				Dim strCustomProperty02 As String = xmlChosenCostCentre.Item("Costing_Code_2").InnerText
				Dim strCustomProperty03 As String = xmlChosenCostCentre.Item("Costing_Code_3").InnerText
				Dim strCustomProperty04 As String = xmlChosenCostCentre.Item("Costing_Code_4").InnerText
				If (strCustomProperty01 <> previousPosition.GetValue("CustomProperty01").ToString) Then
					previousPosition.PutValue("CustomProperty01", strCustomProperty01)
				End If
				If (strCustomProperty02 <> previousPosition.GetValue("CustomProperty02").ToString) Then
					previousPosition.PutValue("CustomProperty02", strCustomProperty02)
				End If
				If (strCustomProperty03 <> previousPosition.GetValue("CustomProperty03").ToString) Then
					previousPosition.PutValue("CustomProperty03", strCustomProperty03)
				End If
				If (strCustomProperty04 <> previousPosition.GetValue("CustomProperty04").ToString) Then
					previousPosition.PutValue("CustomProperty04", strCustomProperty04)
				End If
				If previousPosition.IsChanged() = True Then
					CCC_NLog_WriteLog(loggerName, "Debug", $"Updating Org {strPreviousNumber} with cost code information")
					previousPosition.Save(Session)
				End If
			Catch ex As Exception ' possible concurrency issue - object has changed since bulk load from DB - try again with fresh object
				If retryCount < 2 Then
					retryCount += 1
					CCC_NLog_WriteLog(loggerName, "Debug", $"Retry {retryCount} for cost centre update {strPreviousNumber}: {ex.Message}")
					Thread.Sleep(100)
					GoTo RetryCosting
				Else
					Throw
				End If
			End Try

			' reset for next position and add current
			listXmlElMultiple.Clear()
			listXmlElMultiple.Add(node)
		End If
		xmlElPrevious = node
		
		' Do not process position data that we have already seen
		If (xmlOrgIDs.Contains(strNumber)) Then
			CCC_NLog_WriteLog(loggerName, "Debug", $"Already processed position data for {strNumber}, skipping to next element")
			Continue For
		End If

		CCC_NLog_WriteLog(loggerName, "Debug", $"Processing position data in XML for {strNumber}")
		xmlOrgIDs.Add(strNumber)
		If dbOrgIDs.Contains(strNumber) Then
			retryCount = 0
			RetryUpdate:
			Try
				' org exists in OneIM. Update attributes if needed
				'dbOrgs.Clear()
				'dbOrgs.Prototype.WhereClause = "Ident_Org = '" & strNumber & "' AND ImportSource = '" & importSource & "'"
				CCC_NLog_WriteLog(loggerName, "Debug", "Load existing Org.Ident_Org = '" & strNumber & "'")
				'dbOrgs.Load()
				'Dim singleObj As ISingleDbObject = dbOrgs(0).Create()
				Dim singleObj As IEntity = If(retryCount = 0, dbOrgDict(strNumber), Session.Source.Get("Org", dbOrgDict(strNumber).GetValue("UID_Org").ToString()))
				For Each nodeItem As System.Xml.XmlElement In node
					' compare attribute values between XML doc and DB object
					Select Case LCase(nodeItem.Name)
						Case "position_status"
							' check DB record for status (Report only scoped to Show Active Positions)
							If (strStatus.ToUpperInvariant() = "ACTIVE") AndAlso ((singleObj.GetValue("CustomProperty09").ToString.ToUpperInvariant() <> "") OrElse (singleObj.GetValue("CustomProperty10").ToString.ToUpperInvariant() <> "")) Then
								' XML shows active, position is inactive in DB. Set to active
								singleObj.PutValue("CustomProperty09", "")
								singleObj.PutValue("CustomProperty10", "")
							End If
						Case "position_full_title"
							If (strTitle <> singleObj.GetValue("InternalName").ToString) Then
								singleObj.PutValue("InternalName", strTitle)
							End If
						Case "classification"
							If (strClassification <> singleObj.GetValue("Remarks").ToString) Then
								singleObj.PutValue("Remarks", strClassification)
							End If
						Case "location_code"
							'Dim strLocGUID As String = Connection.GetSingleProperty("Locality", "UID_Locality", "Ident_locality = '" & strLocation & "' AND ImportSource = '" & importSource & "'")
							'If (strLocGUID.ToUpperInvariant() <> singleObj.GetValue("UID_Locality").ToString.ToUpperInvariant()) Then
							'	If strLocGUID.Length() > 1 Then
							'		singleObj.PutValue("UID_Locality", strLocGUID)
							'	End If
							'End If
							Dim strLocGUID As String = dbLocalityDict.GetValueOrDefault(strLocation)
							If (strLocGUID IsNot Nothing AndAlso strLocGUID.ToUpperInvariant() <> singleObj.GetValue("UID_Locality").ToString.ToUpperInvariant() AndAlso strLocGUID.Length() > 1) Then
								singleObj.PutValue("UID_Locality", strLocGUID)
							End If
						Case "reports_to_position"
							'Dim parentOrgGUID As String = Connection.GetSingleProperty("Org", "UID_Org", "Ident_Org = '" & strParentNumber & "' AND ImportSource = '" & importSource & "'").ToString()
							'If (parentOrgGUID.ToUpperInvariant() <> singleObj.GetValue("UID_ParentOrg").ToString.ToUpperInvariant()) Then
							'	' parent org has changed. Load new GUID, set to current dept object
							'	If parentOrgGUID.Length() > 1 Then
							'		singleObj.PutValue("UID_ParentOrg", parentOrgGUID)
							'	Else 
							'		singleObj.PutValue("UID_ParentOrg", Nothing)
							'	End If
							'End If
							Dim parentOrg As IEntity = dbOrgDict.GetValueOrDefault(strParentNumber)
							If parentOrg IsNot Nothing Then
								Dim parentOrgGUID As String = parentOrg.GetValue("UID_Org").ToString
								If (parentOrgGUID.ToUpperInvariant() <> singleObj.GetValue("UID_ParentOrg").ToString.ToUpperInvariant() AndAlso parentOrgGUID.Length() > 1) Then
									singleObj.PutValue("UID_ParentOrg", parentOrgGUID)
								End If
							End If
						Case "organisation_unit_number"
							'Dim deptGUID As String = Connection.GetSingleProperty("Department", "UID_Department", "ObjectID = '" & strOrgUnit & "' AND ImportSource = '" & importSource & "'").ToString()
							'If (deptGUID.ToUpperInvariant() <> singleObj.GetValue("UID_Department").ToString.ToUpperInvariant()) Then
							'	' department has changed. set to new dept object
							'	If deptGUID.Length() > 1 Then
							'		singleObj.PutValue("UID_Department", deptGUID)
							'	End If
							'	
							'	' Calculate Mail Changes for Person in Position
							'	Dim fullpath As String = Connection.GetSingleProperty("Department", "FullPath", "UID_Department = '" & deptGUID & "' AND ImportSource = '" & importSource & "'").ToString()
							'	CCC_Person_Name_Change_ByDepartment(deptGUID, fullpath)
							'End If
							Dim deptGUID As String = dbDepartmentUidDict.GetValueOrDefault(strOrgUnit)
							If (deptGUID.ToUpperInvariant() <> singleObj.GetValue("UID_Department").ToString.ToUpperInvariant()) Then
								' department has changed. set to new dept object
								If deptGUID.Length() > 1 Then
									singleObj.PutValue("UID_Department", deptGUID)
								End If
								
								' 26/07/2025 - GG - CCC_Person_Name_Change_ByDepartment only operates on first person found in this position, needs updating if we go back to multi domain config
								' Calculate Mail Changes for Person in Position
								Dim fullPath As String = dbDepartmentFullPathDict.GetValueOrDefault(strOrgUnit)
								If fullPath IsNot Nothing Then
								 	CCC_Person_Name_Change_ByDepartment(deptGUID, fullPath)
								End If
							End If
					End Select
				Next
				If singleObj.IsChanged() = True Then
					' org's attribute values have changed. Save the record to the DB
					'Stop
					CCC_NLog_WriteLog(loggerName, "Debug", $"Updating Org {strNumber}")
					singleObj.Save(Session)
					intUpdatedObjs = intUpdatedObjs + 1
				End If
			Catch ex As Exception When ex.Message.Contains("Error saving")
		 	    If retryCount < 2 Then
					retryCount += 1
					CCC_NLog_WriteLog(loggerName, "Debug", $"Retry {retryCount} for org update {strNumber}: {ex.Message}")
					Thread.Sleep(100)
					GoTo RetryUpdate
				Else
					Throw
				End If
			Catch ex As Exception
				Dim strErrorMsg As StringBuilder = New StringBuilder
				strErrorMsg.AppendLine("Error updating position attributes.")
				strErrorMsg.AppendLine("Position ID: " & strNumber)
				strErrorMsg.AppendLine(ex.Message())
				CCC_NLog_WriteLog(loggerName, "Error", strErrorMsg.ToString())
				RaiseMessage(MsgSeverity.Serious, "AURION - CCC_Position_Import " & vbCrLf & strErrorMsg.ToString())
			End Try
		Else
			Try
				' org not in OneIM. Create it
				CCC_NLog_WriteLog(loggerName, "Debug", "New Org")
				Dim newDbObject As IEntity = Session.Source.CreateNew("Org")
				newDbObject.PutValue("ImportSource", importSource)
				newDbObject.PutValue("UID_OrgRoot", strUIDOrgRoot)
				'newDbObject.PutValue("CustomProperty01", "AUR") ' - debugging purposes
				newDbObject.PutValue("Ident_Org", strNumber)
				newDbObject.PutValue("InternalName", strTitle)
				newDbObject.PutValue("Remarks", strClassification)
				' Report only scope to Active positions, active check left in case filter is removed
				If Not (strStatus.ToUpperInvariant() = "ACTIVE") Then
					newDbObject.PutValue("CustomProperty09", "POSITION IS INACTIVE")
				End If
				If strParentNumber.Length() > 0 Then
					'Dim parentGUID As String = Connection.GetSingleProperty("Org", "UID_Org", "Ident_Org = '" & strParentNumber & "' AND ImportSource = '" & importSource & "'")
					'If parentGUID.Length() > 1 Then
					'	newDbObject.PutValue("UID_ParentOrg", parentGUID)
					'End If
					Dim parentOrg As IEntity = dbOrgDict.GetValueOrDefault(strParentNumber)
					If parentOrg IsNot Nothing Then
						Dim parentOrgGUID As String = parentOrg.GetValue("UID_Org").ToString
						If parentOrgGUID.Length() > 1 Then
							newDbObject.PutValue("UID_ParentOrg", parentOrgGUID)
						End If
					End If
				End If
				If strLocation.Length() > 0 Then
					Dim locGUID As String = dbLocalityDict.GetValueOrDefault(strLocation) 'Connection.GetSingleProperty("Locality", "UID_Locality", "Ident_Locality = '" & strLocation & "' AND ImportSource = '" & importSource & "'")
					If locGUID.Length() > 1 Then
						newDbObject.PutValue("UID_Locality", locGUID)
					End If
				End If
				If strOrgUnit.Length() > 0 Then
					Dim deptGUID As String = dbDepartmentUidDict.GetValueOrDefault(strOrgUnit)'Connection.GetSingleProperty("Department", "UID_Department", "ObjectID = '" & strOrgUnit & "' AND ImportSource = '" & importSource & "'")
					If deptGUID.Length() > 1 Then
						newDbObject.PutValue("UID_Department", deptGUID)
					End If
				End If
				CCC_NLog_WriteLog(loggerName, "Debug", "Creating Org")
				Using uow As IUnitOfWork = Session.StartUnitOfWork()
					uow.Put(newDbObject)
					uow.Commit()
				End Using
				' Load the object back out of DB to add to dict
				dbOrgDict(strNumber) = Session.Source.Get("Org", newDbObject.GetValue("UID_Org").ToString())
				'newDbObject.Save()
				intNewObjs = intNewObjs + 1
			Catch ex As Exception
				Dim strErrorMsg As StringBuilder = New StringBuilder
				strErrorMsg.AppendLine("Error creating a new position.")
				strErrorMsg.AppendLine("Position ID: " & strNumber)
				strErrorMsg.AppendLine(ex.Message())
				CCC_NLog_WriteLog(loggerName, "Error", strErrorMsg.ToString())
				RaiseMessage(MsgSeverity.Serious, "AURION - CCC_Position_Import " & vbCrLf & strErrorMsg.ToString())
			End Try
		End If
		CCC_NLog_WriteLog(loggerName, "Debug", $"Finished processing position data in XML for {strNumber}")
	Next
	CCC_NLog_WriteLog(loggerName, "Debug", "Looping through XML complete, checking for entries in DB that are missing from query result")
	' handle those which only exist in OneIM
	Dim dbOnlyIDs As ArrayList = New ArrayList
	For Each dbID In dbOrgIDs
		If Not (xmlOrgIDs.Contains(dbID)) Then
			dbOnlyIDs.Add(dbID)
		End If
	Next
	CCC_NLog_WriteLog(loggerName, "Debug", $"Finished missing entry comparison, found {dbOnlyIDs.Count} entries in DB not present in XML")
	If dbOnlyIDs.Count > 0 Then
		' items in DB which do not exist in Aurion XML feed
		For Each dbObjID As String In dbOnlyIDs
			retryCount = 0
			RetryDeactivate:
			Try
				'dbOrgs.Clear()
				'dbOrgs.Prototype.WhereClause = "Ident_Org = '" & dbObjID & "' AND ImportSource = '" & importSource & "'"
				'dbOrgs.Load()
				'Dim singleObj As ISingleDbObject = dbOrgs(0).Create()
				Dim singleObj As IEntity = dbOrgDict(dbObjID)
				If singleObj.GetValue("CustomProperty10").ToString.ToUpperInvariant() <> "DOES_NOT_EXIST" Then
					singleObj.PutValue("CustomProperty10", "DOES_NOT_EXIST")
					CCC_NLog_WriteLog(loggerName, "Debug", $"Deactivating Org {dbObjID}")
					singleObj.Save(Session)
					intDeletedObjs = intDeletedObjs + 1
				End If
			Catch ex As Exception When ex.Message.Contains("Error saving")
		 	    If retryCount < 2 Then
					retryCount += 1
					CCC_NLog_WriteLog(loggerName, "Debug", $"Retry {retryCount} for org deactivation {dbObjID}: {ex.Message}")
					Thread.Sleep(100)
					GoTo RetryDeactivate
				Else
					Throw
				End If
			Catch ex As Exception
				Dim strErrorMsg As StringBuilder = New StringBuilder
				strErrorMsg.AppendLine("Error deactivating a position.")
				strErrorMsg.AppendLine("Position ID: " & dbObjID)
				strErrorMsg.AppendLine(ex.Message())
				CCC_NLog_WriteLog(loggerName, "Error", strErrorMsg.ToString())
				RaiseMessage(MsgSeverity.Serious, "AURION - CCC_Position_Import " & vbCrLf & strErrorMsg.ToString())
			End Try
		Next
	End If
	' return some stats
	Dim strWrite As StringBuilder = New StringBuilder
	strWrite.AppendLine("AURION HR - Position Import Script")
	strWrite.AppendLine("Total positions created: " & intNewObjs)
	strWrite.AppendLine("Total positions updated: " & intUpdatedObjs)
	strWrite.AppendLine("Total positions deactivated: " & intDeletedObjs)
	strRtnValue = strWrite.ToString()
	RaiseMessage(MsgSeverity.Info, "AURION - CCC_Position_Import " & vbCrLf & strWrite.ToString())
	CCC_NLog_WriteLog(loggerName, "Debug", "Exiting CCC_Position_Import()")
	Return strRtnValue
End Function

' ***** 16/06/2022 - Brian Pack- Implement Filter Query
Public Function CCC_Position_Import_Filter(strUIDOrgRoot As String, loggerName As String, ByVal importSource As String) As String
	Dim configBase As String = CCC_Aurion_GetConfigBase(importSource)

		' ***** 16/06/2022 - Brian Pack- Implement Filter Query
	CCC_NLog_WriteLog(loggerName, "Debug", "Build Sorted List of Position Numbers (Position: Ident_Org)")
	Dim dbOrgEnum As List(Of String) = New List(Of String)
	Dim dbOrgCol As IColDbObject = Connection.CreateCol("Org")
	dbOrgCol.Prototype("UID_Org").IsDisplayItem = True
	dbOrgCol.Prototype("Ident_Org").IsDisplayItem = True
	dbOrgCol.Prototype.WhereClause = "UID_ORGROOT = '" & strUIDOrgRoot & "'  AND ImportSource = '" & importSource & "'"
	dbOrgCol.Load()
	
	Dim trimPrefix As Char() = New Char() {}
	trimPrefix = Connection.GetConfigParm(configBase & "\PersonnelNumberPrefix").ToString().ToCharArray()
	
	For Each dbOrg In dbOrgCol
		dbOrgEnum.Add(dbOrg.GetEntity.GetValue("Ident_Org").ToString().TrimStart(trimPrefix))
	Next
	' Add Largest Possible Employee Number to capture new employees 
	dbOrgEnum.Add(Connection.GetConfigParm(configBase & "\QueryFilterFields\Position_PositionNumber\Maximum").ToString())
	dbOrgEnum.Sort(StringComparer.Ordinal)
	
	Dim filterPattern As String = Connection.GetConfigParm(configBase & "\QueryFilterFields\Position_PositionNumber") & "={0}|" & Connection.GetConfigParm(configBase & "\QueryFilterFields\Position_PositionNumber") & "={1}"
	Dim blockSize As Int32 = 2000
	Int32.TryParse(Connection.GetConfigParm(configBase & "\QueryFilterFields\BlockSize"), blockSize)

	' Build Query blocks for IAM_EMPLOYMENT report XML from Aurion
	Dim filter As String = String.Empty
	Dim minVal As String = ""
	Dim maxVal As String = ""
	
	' Calaculate Filter Queries
	Dim index As Int32 = 0
	While (True)
		If index < dbOrgEnum.count - 1 Then
			minVal = dbOrgEnum(index)
			
			If (index + blockSize >= dbOrgEnum.count) Then
				index = dbOrgEnum.count - 1
			Else
				index = index + blockSize
			End If
			maxVal = dbOrgEnum(index)
			filter = String.Format("{2}#" & filterPattern, minVal, maxVal, filter)		
			Continue While
		Else
			Exit While
		End If	
	End While

	CCC_NLog_WriteLog(loggerName, "Debug", "Filter Calculation:" & filter)
	' ***** 16/06/2022 - Brian Pack - Filter Calculation Complete
	
	Return filter
End Function

''' <summary>
''' Import of Termination Record Date from Aurion via Schedule - KG - 2/14/2024
''' </summary>
''' <returns>String result message</returns>
''' 
Public Function CCC_TermRecord_Import(Optional ByVal importSource As String = "AUR") As String
	Dim configBase As String = CCC_Aurion_GetConfigBase(importSource)
	Dim loggerName As String = CCC_Aurion_GetLoggerPrefix(importSource) & "_TERMRECORD"
	CCC_NLog_WriteLog(loggerName, "Debug", "Entering CCC_TermRecord_Import()")

	
	'
	' This script will sync the Termination records from Aurion HR to the Person table in OneIM
	'
	' vars
	Dim strRtnValue As String = String.Empty
	Dim intNewObjs As Integer = 0
	Dim intUpdatedObjs As Integer = 0
	Dim intDeletedObjs As Integer = 0
	Dim strXMLDoc As String = String.Empty
	Dim xmlDoc As Xml.XmlDocument = New Xml.XmlDocument

	' Initiate Web Service
	Dim QUERY_ID As String = Connection.GetConfigParm(configBase & "\QueryFilterFields\QueryIDs\TermRecord").ToString()
	Dim P_TOKEN As String = CCC_Aurion_LOGON(importSource)
	
	' Perform Termination Single-Query to XML Document
	strXMLDoc = CCC_Aurion_QUERY_TO_XML(loggerName, P_TOKEN, QUERY_ID, String.Empty, importSource)
	
	' Load XML output from Aurion	
	Try
	xmlDoc.LoadXml(strXMLDoc)
	Catch ex As Exception
	Dim strErrorMsg As StringBuilder = New StringBuilder
	strErrorMsg.AppendLine("Error loading XML.")
	strErrorMsg.AppendLine(ex.Message())
	' Disconnect Web Service
	CCC_NLog_WriteLog(loggerName, "Debug", "Calling CCC_Aurion_LOGOFF(P_TOKEN, importSource)")
	CCC_Aurion_LOGOFF(P_TOKEN, importSource)
	' Throw error
	CCC_NLog_WriteLog(loggerName, "Fatal", strErrorMsg.ToString())
	Throw New AdHocDataException("Error loading XML. " & strErrorMsg.ToString())
	End Try
	
	' Disconnect Web Service
	CCC_NLog_WriteLog(loggerName, "Debug", "Calling CCC_Aurion_LOGOFF(P_TOKEN, importSource)")
	CCC_Aurion_LOGOFF(P_TOKEN, importSource)
	
	' Main processing
	RaiseMessage(MsgSeverity.Info, "AURION - CCC_TermRecord_Import - Starting snychronisation")
	' SYNC WITH ONEIM OBJECTS
	' load person objects from DB
	Dim dbPersons As IColDbObject = Connection.CreateCol("Person")
	dbPersons.Prototype.PutValue("ImportSource", importSource)
	dbPersons.Prototype.WhereClause = "CCC_EmployeeNumber IS NOT NULL AND ImportSource = '" & importSource & "'"
	dbPersons.Prototype("PersonnelNumber").IsDisplayItem = True
	dbPersons.Prototype("CCC_EmployeeNumber").IsDisplayItem = True
	CCC_NLog_WriteLog(loggerName, "Debug", "Load Person.CCC_EmployeeNumber IS NOT NULL")
	dbPersons.Load()
	Dim dbPersonIDs As ArrayList = New ArrayList
	Dim dbTermPersonIDs As ArrayList = New ArrayList
	Dim xmlPersonIDs As ArrayList = New ArrayList
	For Each dbPerson In dbPersons
		dbPersonIDs.Add(dbPerson.GetValue("PersonnelNumber").ToString())
	Next
	' compare with org units in xml doc
	CCC_NLog_WriteLog(loggerName, "Debug", "Loop through XML")
		
	For Each node As System.Xml.XmlElement In xmlDoc.DocumentElement
		Dim strPerNumber As String = node.Item("Person_Number").InnerText
		Dim strEmpNumber As String = node.Item("Employee_Number").InnerText
		Dim strTermDate As String = node.Item("Date_Terminated").InnerText
		Dim strCreateDate As String = node.Item("Create_Date_Time_Stamp").InnerText
		Dim strModifyDate As String = node.Item("Modify_Date_Time_Stamp").InnerText
		
		Dim personNumberPrefix As String = Connection.GetConfigParm(configBase & "\PersonnelNumberPrefix").ToString()
		strPerNumber = personNumberPrefix & strPerNumber

		xmlPersonIDs.Add(strPerNumber)
		If dbPersonIDs.Contains(strPerNumber) Then
			Try
				' person exists in OneIM. Update attributes if needed
				dbPersons.Clear()
				dbPersons.Prototype.WhereClause = "PersonnelNumber = '" & strPerNumber & "' AND ImportSource = '" & importSource & "'"
				CCC_NLog_WriteLog(loggerName, "Debug", "Load existing Person.PersonnelNumer = '" & strPerNumber & "'")
				dbPersons.Load()
				Dim singleObj As ISingleDbObject = dbPersons(0).Create()
				For Each nodeItem As System.Xml.XmlElement In node
					Select Case LCase(nodeItem.Name)
						Case "create_date_time_stamp"
							If 	strCreateDate <> "" Then
								Dim dtCreateDate As DateTime = DateTime.ParseExact(strCreateDate, "dd/MM/yyyy", System.Globalization.DateTimeFormatInfo.InvariantInfo)
								If (singleObj.GetValue("CCC_LastKnown_TermDate").Date = Nothing) Then
									singleObj.PutValue("CCC_LastKnown_TermDate", dtCreateDate)
								ElseIf (singleObj.GetValue("CCC_LastKnown_TermDate").Date  < dtCreateDate) Then
									singleObj.PutValue("CCC_LastKnown_TermDate", dtCreateDate)
								End If
							End If
						Case "modify_date_time_stamp"
							If 	strModifyDate <> "" Then
								Dim dtModifyDate As DateTime = DateTime.ParseExact(strModifyDate, "dd/MM/yyyy", System.Globalization.DateTimeFormatInfo.InvariantInfo)
								If (singleObj.GetValue("CCC_LastKnown_TermDateUpdate").Date = Nothing) Then
									singleObj.PutValue("CCC_LastKnown_TermDateUpdate", dtModifyDate)
								ElseIf (singleObj.GetValue("CCC_LastKnown_TermDateUpdate").Date < dtModifyDate) Then
									singleObj.PutValue("CCC_LastKnown_TermDateUpdate", dtModifyDate)
								End If
							End If	
					End Select

					If singleObj.IsChanged() = True Then
						CCC_NLog_WriteLog(loggerName, "Debug", "Updating Person")
						singleObj.Save()
						intUpdatedObjs = intUpdatedObjs + 1
					End If
				Next
			Catch ex As Exception
				Dim strErrorMsg As StringBuilder = New StringBuilder
				strErrorMsg.AppendLine("Error updating person attributes.")
				strErrorMsg.AppendLine("Person ID: " & strPerNumber)
				strErrorMsg.AppendLine(ex.Message())
				CCC_NLog_WriteLog(loggerName, "Error", strErrorMsg.ToString())
				RaiseMessage(MsgSeverity.Serious, "AURION - CCC_TermRecord_Import " & vbCrLf & strErrorMsg.ToString())
			End Try
		End If
	Next
		' return some stats
	Dim strWrite As StringBuilder = New StringBuilder
	strWrite.AppendLine("AURION HR - Person Termination Date Schedule Import Script")
	strWrite.AppendLine("Total terminated date stamp created: " & intUpdatedObjs)
	strWrite.AppendLine("Total termination date stamp cleared: " & intDeletedObjs)
	strRtnValue = strWrite.ToString()
	RaiseMessage(MsgSeverity.Info, "AURION - CCC_TermRecord_Import " & vbCrLf & strWrite.ToString())
	CCC_NLog_WriteLog(loggerName, "Debug", "Exiting CCC_TermRecord_Import()")
	Return strRtnValue	
End Function

''' <summary>
''' Perform multiple queries and combine into single XML string
''' </summary>
Public Function CCC_Aurion_QUERY_TO_XML(ByVal loggerName As String, ByVal P_TOKEN As String, ByVal QUERY_ID As String, ByVal FILTERS As String, ByVal importSource As String) As String
	Dim configBase As String = CCC_Aurion_GetConfigBase(importSource)
	CCC_NLog_WriteLog(loggerName, "Debug", "Entering CCC_Aurion_Queries_To_XML()")
	Dim strXMLDocument As String = String.Empty
	Dim strEmptyDoc As String = String.Empty
	Dim xmlDocCombined As Xml.XmlDocument = New Xml.XmlDocument
	Dim xmlDocLoop As Xml.XmlDocument = New Xml.XmlDocument
	Dim sw As IO.StringWriter = New IO.StringWriter()
	Dim xw As Xml.XmlTextWriter = New Xml.XmlTextWriter(sw)
	Dim filterMap As String()
	Dim P_FUNCTION As String = Connection.GetConfigParm(configBase & "\QueryFilterFields\QueryIDs").ToString()
	Dim P_DELIMITER As String = ","
	Dim P_PARAMETERS As String = "QUERY_ID=" & QUERY_ID & "{0}" & P_DELIMITER & "RETURN_XML=T"
	Dim parametersFilter As String = String.Empty
	
	Dim filtersMap As String() = FILTERS.Split(New Char(){"#"c}, StringSplitOptions.RemoveEmptyEntries)
	If filtersMap.Length > 0 Then
		filterMap = filtersMap(0).ToString().Split(New Char(){"|"c}, StringSplitOptions.RemoveEmptyEntries)
		If filterMap.Length > 0 Then
			parametersFilter = P_DELIMITER & "FILTER=" & filterMap(0).ToString()
			If filterMap.Length = 2 Then
				parametersFilter = parametersFilter & P_DELIMITER & "FILTER_HI=" & filterMap(1).ToString()
			End If
		End If
	End If
	CCC_NLog_WriteLog(loggerName, "Debug", "Calling CCC_Aurion_CALLFUNCTION3(P_TOKEN, """ & P_FUNCTION & """, """ & P_DELIMITER & """, """ & String.Format(P_PARAMETERS, parametersFilter) & """)")
	
	strXMLDocument = CCC_Aurion_CALLFUNCTION3(P_TOKEN, P_FUNCTION, P_DELIMITER, String.Format(P_PARAMETERS, parametersFilter), importSource)
	CCC_NLog_WriteLog(loggerName, "Trace", "Result: " & strXMLDocument.ToString())
	If strXMLDocument = Connection.GetConfigParm(configBase & "\NoRecordsOutput") Then
		strEmptyDoc = strXMLDocument
	Else
		Try
			xmlDocCombined.LoadXml(strXMLDocument)
		Catch ex As Exception
			Dim strErrorMsg As StringBuilder = New StringBuilder
			strErrorMsg.AppendLine("Error loading XML.")
			strErrorMsg.AppendLine("Aurion API Query 'QUERY_TO_XML' output: " & strXMLDocument)
			strErrorMsg.AppendLine(ex.Message())
			CCC_NLog_WriteLog(loggerName, "Fatal", strErrorMsg.ToString())
			RaiseMessage(MsgSeverity.Info, "Error loading XML. Aurion API Query output: " & strXMLDocument)
		End Try
	End If
	If filtersMap.Length > 1 Then
		For counter As Integer = 1 To (filtersMap.Length - 1)
			parametersFilter = String.Empty
			strXMLDocument = String.Empty
			filterMap = filtersMap(counter).ToString().Split(New Char(){"|"c}, StringSplitOptions.RemoveEmptyEntries)
			If filterMap.Length > 0 Then
				parametersFilter = P_DELIMITER & "FILTER=" & filterMap(0).ToString()
				If filterMap.Length = 2 Then
					parametersFilter = parametersFilter & P_DELIMITER & "FILTER_HI=" & filterMap(1).ToString()
				End If
			End If
			CCC_NLog_WriteLog(loggerName, "Debug", "Waiting 5000 milliseconds")
			Threading.Thread.Sleep(5000)
			CCC_NLog_WriteLog(loggerName, "Debug", "Calling CCC_Aurion_CALLFUNCTION3(P_TOKEN, """ & P_FUNCTION & """, """ & P_DELIMITER & """, """ & String.Format(P_PARAMETERS, parametersFilter) & """)")
			strXMLDocument = CCC_Aurion_CALLFUNCTION3(P_TOKEN, P_FUNCTION, P_DELIMITER, String.Format(P_PARAMETERS, parametersFilter), importSource)
			CCC_NLog_WriteLog(loggerName, "Trace", "Result: " & strXMLDocument.ToString())
			If strXMLDocument = Connection.GetConfigParm(configBase & "\NoRecordsOutput") Then
				strEmptyDoc = strXMLDocument
			Else
				Try
					xmlDocLoop.LoadXml(strXMLDocument)
				Catch ex As Exception
					Dim strErrorMsg As StringBuilder = New StringBuilder
					strErrorMsg.AppendLine("Error loading XML.")
					strErrorMsg.AppendLine("Aurion API Query 'QUERY_TO_XML' output: " & strXMLDocument)
					strErrorMsg.AppendLine(ex.Message())
					CCC_NLog_WriteLog(loggerName, "Fatal", strErrorMsg.ToString())
					RaiseMessage(MsgSeverity.Info, "Error loading XML. Aurion API Query output: " & strXMLDocument)
					Throw ex
				End Try
				Dim swx As IO.StringWriter = New IO.StringWriter()
				Dim xwx As Xml.XmlTextWriter = New Xml.XmlTextWriter(swx)
				xmlDocCombined.DocumentElement.LastChild.WriteTo(xwx)
				Dim prevNode As String = swx.ToString()
				swx  = New IO.StringWriter()
				xwx  = New Xml.XmlTextWriter(swx)
				xmlDocLoop.DocumentElement.FirstChild.WriteTo(xwx)
				Dim nextNode As String = swx.ToString()
				If String.Equals(prevNode, nextNode) Then
					CCC_NLog_WriteLog(loggerName, "Trace", "XML Duplicate From Filter Query Range Identified")
					CCC_NLog_WriteLog(loggerName, "Trace", "XML Duplicate Removed: " & nextNode)
					xmlDocLoop.DocumentElement.RemoveChild(xmlDocLoop.DocumentElement.FirstChild)
				End If
				For Each nod As Xml.XmlNode In xmlDocLoop.DocumentElement.ChildNodes
					Dim tmpNod As Xml.XmlNode = xmlDocCombined.ImportNode(nod, True)
					xmlDocCombined.DocumentElement.AppendChild(tmpNod)				
				Next
			End If
		Next
	End If
	If Not String.IsNullOrEmpty(strEmptyDoc) Then
		CCC_NLog_WriteLog(loggerName, "Debug", "A query returned an empty document: " & strEmptyDoc.ToString())
	End If
	xmlDocCombined.WriteTo(xw)
	CCC_NLog_WriteLog(loggerName, "Trace", "Combined Document: " & sw.ToString())
	CCC_NLog_WriteLog(loggerName & "_XML", "Trace", "Combined Document: " & sw.ToString())
	CCC_NLog_WriteLog(loggerName, "Debug", "Exiting CCC_Aurion_Queries_To_XML()")
	
	If String.IsNullOrEmpty(sw.ToString()) AndAlso Not String.IsNullOrEmpty(strEmptyDoc) Then
		Return strEmptyDoc
	Else
		Return sw.ToString()
	End If
End Function


Public Function CCC_Aurion_GetLoggerPrefix(ByVal importSource As String) As String
	Dim configBase As String = CCC_Aurion_GetConfigBase(importSource)
	Dim loggerPrefix As String = "AURION_ESS"
	If Not (String.IsNullOrEmpty(Connection.GetConfigParm(configBase & "\LoggerPrefix"))) Then
		loggerPrefix = Connection.GetConfigParm(configBase & "\LoggerPrefix").ToString()
	End If
	Return loggerPrefix
End Function

Public Function CCC_Aurion_GetConfigBase(ByVal importSource As String) As String
	Dim translation As String = Connection.GetConfigParm("Custom\AURION_IMPORTSOURCE\" & importSource).ToString().ToUpper()
	If (String.IsNullOrEmpty(translation)) Then
		translation = Connection.GetConfigParm("Custom\AURION_IMPORTSOURCE\AUR").ToString().ToUpper()
	End If
	Return "Custom\" & translation
End Function


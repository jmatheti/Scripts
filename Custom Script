		If (importSource.Equals(Connection.GetConfigParm("Custom\AURION_DISR\ImportSource").ToString().ToUpper())) Then
			' create webservice class
			Using ws As AurionDISR.EV397_AURION_WSService = VID_GetWebService(Of AurionDISR.EV397_AURION_WSService)()

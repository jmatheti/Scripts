Private Function ConfigureAurionTcpKeepAlive(ByVal serviceUrl As String) As String
    Try
        Dim serviceUri As New Uri(serviceUrl)
        Dim servicePoint As ServicePoint = ServicePointManager.FindServicePoint(serviceUri)
        servicePoint.SetTcpKeepAlive(True, 30000, 1000) ' 30sec idle, 1sec interval
        Return $"TCP KeepAlive enabled for {serviceUri.Host}"
    Catch ex As Exception
        Return $"TCP KeepAlive configuration failed: {ex.Message}"
    End Try
End Function

''' <summary>
''' Aurion Web Service CALLFUNCTION3
''' </summary>
''' <param name="P_TOKEN">Token from CCC_Aurion_LOGON</param>
''' <param name="P_FUNCTION">Remote function</param>
''' <param name="P_DELIMITER">Delimiter - usually comma</param>
''' <param name="P_PARAMETERS">Function parmeters</param>
''' <returns>P_OUTPUT content</returns>
''' 
Public Function CCC_Aurion_CALLFUNCTION3(ByVal P_TOKEN As String, ByVal P_FUNCTION As String, ByVal P_DELIMITER As String, ByVal P_PARAMETERS As String, ByVal importSource As String) As String
	Dim strReturnValue As String = String.Empty
	Dim returnValue As Int32 = 0
	Dim P_WRAPPER As String = String.Empty
	Dim P_OUTPUT As String = String.Empty
	Dim P_MESSAGE As String = String.Empty
	Dim P_STATUS As Decimal = 0
	Dim timeoutRetries As Decimal = 1
	Try
		timeoutRetry:
		' create webservice class
		If (importSource.Equals(Connection.GetConfigParm("Custom\AURION_DISR\ImportSource").ToString().ToUpper())) Then
			Using ws As AurionDISR.EV397_AURION_WSService = VID_GetWebService(Of AurionDISR.EV397_AURION_WSService)()
				ws.Timeout = 30000000
				' call WebService
				returnValue = ws.CALLFUNCTION3(P_TOKEN, P_FUNCTION, P_DELIMITER, P_WRAPPER, P_PARAMETERS, P_OUTPUT, P_MESSAGE, P_STATUS)
				If returnValue = 0 And Not (P_OUTPUT Is Nothing) And P_MESSAGE Is Nothing Then
					' api call success with output
					strReturnValue = P_OUTPUT
				ElseIf returnValue = 0 And Not (P_MESSAGE Is Nothing) Then
					' api call success, but no output
					strReturnValue = "Status: " & P_STATUS.ToString() & " Message: " & P_MESSAGE
				ElseIf returnValue = 0 And P_MESSAGE Is Nothing And P_OUTPUT Is Nothing Then
					strReturnValue = "Success"
				Else
					Dim wsMsgException As Exception = New Exception(P_MESSAGE)
					Throw New ViException("AURION DISR - CALLFUNCTION3 - Error getting data", wsMsgException)
				End If
			End Using
		Else If (importSource.Equals(Connection.GetConfigParm("Custom\AURION_DCCEEW\ImportSource").ToString().ToUpper())) Then
			Using ws As AurionDCCEEW.EV397_AURION_WSService = VID_GetWebService(Of AurionDCCEEW.EV397_AURION_WSService)()
				ws.Timeout = 30000000
				' call WebService
				returnValue = ws.CALLFUNCTION3(P_TOKEN, P_FUNCTION, P_DELIMITER, P_WRAPPER, P_PARAMETERS, P_OUTPUT, P_MESSAGE, P_STATUS)
				If returnValue = 0 And Not (P_OUTPUT Is Nothing) And P_MESSAGE Is Nothing Then
					' api call success with output
					strReturnValue = P_OUTPUT
				ElseIf returnValue = 0 And Not (P_MESSAGE Is Nothing) Then
					' api call success, but no output
					strReturnValue = "Status: " & P_STATUS.ToString() & " Message: " & P_MESSAGE
				ElseIf returnValue = 0 And P_MESSAGE Is Nothing And P_OUTPUT Is Nothing Then
					strReturnValue = "Success"
				Else
					Dim wsMsgException As Exception = New Exception(P_MESSAGE)
					Throw New ViException("AURION DCCEEW - CALLFUNCTION3 - Error getting data", wsMsgException)
				End If
			End Using	
		Else
			Using ws As Aurion.EV397_AURION_WSService = VID_GetWebService(Of Aurion.EV397_AURION_WSService)()
			    Dim keepAliveResult As String = ConfigureAurionTcpKeepAlive(ws.Url)
                ' CCC_NLog_WriteLog("AURION_ESS_EMPLOYMENT", "Debug", $"Default - {keepAliveResult}") ' only enable for debugging, will write to employment log file
				'ws.Timeout = 30000000
				ws.Timeout = 600000
				' call WebService
				returnValue = ws.CALLFUNCTION3(P_TOKEN, P_FUNCTION, P_DELIMITER, P_WRAPPER, P_PARAMETERS, P_OUTPUT, P_MESSAGE, P_STATUS)
				If returnValue = 0 And Not (P_OUTPUT Is Nothing) And P_MESSAGE Is Nothing Then
					' api call success with output
					strReturnValue = P_OUTPUT
				ElseIf returnValue = 0 And Not (P_MESSAGE Is Nothing) Then
					' api call success, but no output
					strReturnValue = "Status: " & P_STATUS.ToString() & " Message: " & P_MESSAGE
				ElseIf returnValue = 0 And P_MESSAGE Is Nothing And P_OUTPUT Is Nothing Then
					strReturnValue = "Success"
				Else
					Dim wsMsgException As Exception = New Exception(P_MESSAGE)
					Throw New ViException("AURION - CALLFUNCTION3 - Error getting data", wsMsgException)
				End If
			End Using
		End If
	Catch ex As Exception
		' Determine if The operation has timed out
		If ex.Message.Contains("The operation has timed out") And timeoutRetries > 0 Then
			timeoutRetries = timeoutRetries - 1
			GoTo timeoutRetry
		Else
			Throw New ViException("AURION - CALLFUNCTION3 - Error getting data", ex)
		End If
	End Try
	Return strReturnValue
End Function


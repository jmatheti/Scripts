''' <summary>
''' Creates a configured EV397_AURION_WSPortTypeClient for the given endpoint URL and timeout.
''' </summary>
Private Function CreateAurionClient(ByVal serviceUrl As String, ByVal timeoutMs As Integer) As EV397_AURION_WSPortTypeClient
    Dim binding As New BasicHttpBinding()
    binding.MaxBufferSize = 2147483647
    binding.MaxReceivedMessageSize = 2147483647
    binding.AllowCookies = True
    binding.Security.Mode = BasicHttpSecurityMode.Transport
    binding.SendTimeout = TimeSpan.FromMilliseconds(timeoutMs)
    binding.ReceiveTimeout = TimeSpan.FromMilliseconds(timeoutMs)
    Dim endpoint As New EndpointAddress(serviceUrl)
    Return New EV397_AURION_WSPortTypeClient(binding, endpoint)
End Function

''' <summary>
''' Returns the Aurion service URL for the given importSource config key base.
''' </summary>
Private Function GetAurionServiceUrl(ByVal configBase As String) As String
    Return Connection.GetConfigParm(configBase & "\ServiceUrl").ToString()
End Function

''' <summary>
''' Aurion Web Service CALLFUNCTION3
''' </summary>
''' <param name="P_TOKEN">Token from CCC_Aurion_LOGON</param>
''' <param name="P_FUNCTION">Remote function</param>
''' <param name="P_DELIMITER">Delimiter - usually comma</param>
''' <param name="P_PARAMETERS">Function parameters</param>
''' <param name="importSource">Import source identifier</param>
''' <returns>P_OUTPUT content</returns>
Public Function CCC_Aurion_CALLFUNCTION3(ByVal P_TOKEN As String, ByVal P_FUNCTION As String, ByVal P_DELIMITER As String, ByVal P_PARAMETERS As String, ByVal importSource As String) As String
    Dim strReturnValue As String = String.Empty
    Dim timeoutRetries As Decimal = 1
    Dim configBase As String = CCC_Aurion_GetConfigBase(importSource)
    Dim serviceUrl As String = GetAurionServiceUrl(configBase)
    Try
        timeoutRetry:
        Using ws As EV397_AURION_WSPortTypeClient = CreateAurionClient(serviceUrl, 600000)
            Dim request As New CALLFUNCTION3Request(P_TOKEN, P_FUNCTION, P_DELIMITER, String.Empty, P_PARAMETERS)
            Dim response As CALLFUNCTION3Response = ws.CALLFUNCTION3Async(request).GetAwaiter().GetResult()
            Dim returnValue As Integer = response.return
            Dim P_OUTPUT As String = response.P_OUTPUT
            Dim P_MESSAGE As String = response.P_MESSAGE
            Dim P_STATUS As Decimal = response.P_STATUS
            If returnValue = 0 AndAlso Not (P_OUTPUT Is Nothing) AndAlso P_MESSAGE Is Nothing Then
                strReturnValue = P_OUTPUT
            ElseIf returnValue = 0 AndAlso Not (P_MESSAGE Is Nothing) Then
                strReturnValue = "Status: " & P_STATUS.ToString() & " Message: " & P_MESSAGE
            ElseIf returnValue = 0 AndAlso P_MESSAGE Is Nothing AndAlso P_OUTPUT Is Nothing Then
                strReturnValue = "Success"
            Else
                Dim wsMsgException As Exception = New Exception(P_MESSAGE)
                Throw New ViException("AURION - CALLFUNCTION3 - Error getting data", wsMsgException)
            End If
        End Using
    Catch ex As Exception
        If ex.Message.Contains("The operation has timed out") And timeoutRetries > 0 Then
            timeoutRetries = timeoutRetries - 1
            GoTo timeoutRetry
        Else
            Throw New ViException("AURION - CALLFUNCTION3 - Error getting data", ex)
        End If
    End Try
    Return strReturnValue
End Function

''' <summary>
''' Aurion Web Service Logoff
''' </summary>
''' <param name="P_TOKEN">Token</param>
''' <param name="importSource">Import source identifier</param>
Public Sub CCC_Aurion_LOGOFF(P_TOKEN As String, ByVal importSource As String)
    Dim configBase As String = CCC_Aurion_GetConfigBase(importSource)
    Dim serviceUrl As String = GetAurionServiceUrl(configBase)
    Using ws As EV397_AURION_WSPortTypeClient = CreateAurionClient(serviceUrl, 30000)
        ws.LOGOFFAsync(P_TOKEN).GetAwaiter().GetResult()
    End Using
End Sub

''' <summary>
''' Aurion Web Service Logon
''' </summary>
''' <param name="importSource">Import source identifier</param>
''' <returns>Token</returns>
Public Function CCC_Aurion_LOGON(ByVal importSource As String) As String
    Dim strRtnValue As String = String.Empty
    Dim configBase As String = CCC_Aurion_GetConfigBase(importSource)
    Dim serviceUrl As String = GetAurionServiceUrl(configBase)
    Try
        Dim P_USER As String = Connection.GetConfigParm(configBase & "\Username")
        Dim configPwd As String = Connection.GetConfigParm(configBase & "\Password")
        Dim P_PASSWORD As String = String.Empty
        ' Decrypt Config Parameter
        If configPwd.StartsWith("[C]") Then
            P_PASSWORD = Session.Decrypt(configPwd)
        Else
            P_PASSWORD = configPwd
        End If
        Using ws As EV397_AURION_WSPortTypeClient = CreateAurionClient(serviceUrl, 30000)
            Dim request As New LOGONRequest(P_USER, P_PASSWORD)
            Dim response As LOGONResponse = ws.LOGONAsync(request).GetAwaiter().GetResult()
            If response.return = 0 Then
                strRtnValue = response.P_TOKEN
            Else
                Dim wsMsgException As Exception = New Exception(response.P_MESSAGE)
                Throw New ViException("AURION - LOGON - web service auth error", wsMsgException)
            End If
        End Using
    Catch ex As Exception
        Throw New ViException("AURION - LOGON - web service auth error-", ex)
    End Try
    Return strRtnValue
End Function


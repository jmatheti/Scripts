				If returnValue = 0 Then
					strRtnValue = P_TOKEN
				Else
					' authentication error...
					Dim wsMsgException As Exception = New Exception(P_MESSAGE)
					Throw New ViException("AURION DCCEEW - LOGON - web service auth error", wsMsgException)

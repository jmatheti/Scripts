				Dim configPwd As String = Connection.GetConfigParm("Custom\AURION_DISR\Password")
				Dim P_PASSWORD As String = String.Empty
				' Decrypt Config Parameter
				If configPwd.StartsWith("[C]") Then
					P_PASSWORD = Session.Decrypt(configPwd)
				Else
					P_PASSWORD = configPwd
				End If
				Dim P_TOKEN As String = String.Empty
				Dim P_MESSAGE As String = String.Empty
				Dim P_STATUS As Decimal
				' call WebService
				returnValue = ws.LOGON(P_USER, P_PASSWORD, P_TOKEN, P_MESSAGE, P_STATUS)
